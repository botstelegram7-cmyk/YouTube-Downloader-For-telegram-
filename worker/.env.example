# Download worker — copy to .env for local runs, or paste into the Render dashboard.
# Every variable is validated at boot; the worker exits with a readable list of problems.

# --- Required ---------------------------------------------------------------
# BotFather bot token (NOT the Serverless CLI token). Used for uploads and status edits.
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN
# Shared secret between the Serverless handler and this worker. Generate one:
#   openssl rand -hex 32
WORKER_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# --- Server ----------------------------------------------------------------
# Render sets PORT itself; local default is 8080.
PORT=8080

# --- Job limits (tuned for a 512 MB free instance) --------------------------
# Jobs processed at the same time. Keep 1 on free instances.
MAX_CONCURRENT_DOWNLOADS=1
# Hard limit covering download + mux + upload.
JOB_TIMEOUT_SECONDS=900
# Time allowed for resolving a link into streams.
RESOLVE_TIMEOUT_SECONDS=60
# Parallel range workers used by TypeTube (4 is the memory-safe choice at 512 MB).
DOWNLOAD_WORKERS=4
# Range chunk size in MB (smaller chunks use less memory per worker).
CHUNK_SIZE_MB=8

# --- Delivery ---------------------------------------------------------------
# Largest file to send. Hosted Bot API caps bot uploads at 50 MB; raise this only
# with a local Bot API server.
MAX_UPLOAD_MB=50
# Re-download at a lower quality when the result would not fit.
AUTO_DOWNGRADE=true
MAX_DOWNGRADE_ATTEMPTS=2
# Minimum seconds between progress edits of the status message.
STATUS_UPDATE_SECONDS=6

# --- Fallback engine --------------------------------------------------------
# yt-dlp is used only when TypeTube cannot deliver the file.
YTDLP_FALLBACK=true
YTDLP_TIMEOUT_SECONDS=600

# --- TypeTube (optional) ----------------------------------------------------
# A private key unlocks 256 kbps audio, higher quotas and priority routing.
TYPETUBE_API_KEY=
# Custom cluster, e.g. TYPETUBE_HOST=sg.clusters.typetube.xyz
TYPETUBE_HOST=
TYPETUBE_PORT=

# --- Advanced ---------------------------------------------------------------
# Bot API base URL. Point this at a self-hosted bot API server to lift the 50 MB
# upload cap (then raise MAX_UPLOAD_MB too).
TELEGRAM_API_BASE=https://api.telegram.org
# FFmpeg / yt-dlp executables when they are not on PATH.
FFMPEG_BINARY=
YTDLP_BINARY=

# --- Operations -------------------------------------------------------------
# Refuse to boot when TypeTube cannot run on this Node version.
STRICT_STARTUP=false
# debug | info | warn | error
LOG_LEVEL=info
# true for human-readable logs instead of one-line JSON.
LOG_PRETTY=false
