# Copy to .env and fill in. Every value here has a default in config.py, so the
# only truly required entry is BOT_TOKEN.
#
#   cp .env.example .env
#   python main.py --check        # validates everything below
#
# ---------------------------------------------------------------------------
# 1. Telegram
# ---------------------------------------------------------------------------
# From @BotFather → your bot → API Token. Looks like 123456789:AA...
BOT_TOKEN=

# Optional, and only about the operator's own tools — the bot is open to everyone and
# anybody can download. The owner can use /diag, is credited on /start, and skips the
# fair-use cooldown below. Easiest: your @username, resolved once at startup.
OWNER_USERNAME=
# ...or a numeric id. Send /id to your bot to find yours. Both may be set.
OWNER_USER_ID=0
# Where the startup summary goes; defaults to the owner. Send /id to find the number.
STARTUP_NOTIFY_CHAT_ID=0

# Leave empty to use Telegram's cloud Bot API.
# Point it at a local Bot API server (https://github.com/tdlib/telegram-bot-api) to
# lift uploads from 50 MB to 2000 MB without any account:
#   TELEGRAM_API_BASE=http://telegram-bot-api:8081
TELEGRAM_API_BASE=

# ---------------------------------------------------------------------------
# 2. Uploads larger than 50 MB — MTProto, the 2 GB route   ← recommended
# ---------------------------------------------------------------------------
# Telegram's Bot API refuses bot uploads over 50 MB; that ceiling is Telegram's and
# no application can remove it. Telegram's own protocol, MTProto, allows a bot to
# send up to 2000 MB per file.
#
# Setting the two values below is all it takes. They identify *your Telegram
# application*; your existing BOT_TOKEN still authenticates the bot, so:
#
#   * no second account          * no phone number
#   * no login code              * no session string to store or leak
#
#   1. https://my.telegram.org → "API development tools" → create an application
#   2. copy api_id and api_hash here, set UPLOAD_TRANSPORT=auto (or mtproto)
#   3. restart, then send /limits to the bot: it reports the ceiling it really has
#
# Result: files up to 2000 MB per upload. (4000 MB is Telegram Premium for *people*;
# it is not available to bots, and this bot will never claim it.)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Parallel connections for MTProto uploads. 8 is the default: on a fast link it is the
# difference between a slow trickle and the full speed your connection has. 1-16 accepted.
MT_CONNECTIONS=8

# auto = Bot API for small files, MTProto for anything larger (recommended).
# bot  = never use MTProto, even if it is configured.
# mtproto = always use MTProto (falls back to the Bot API for files it can carry).
UPLOAD_TRANSPORT=auto

# ---------------------------------------------------------------------------
# 3. No size limits — only Telegram's ceilings and your disk
# ---------------------------------------------------------------------------
# There is deliberately no MAX_UPLOAD_MB any more: this application does not cap the
# size of a download or an upload. What applies is Telegram's own protocol ceiling for
# the transport above (50 MB Bot API, 2000 MB MTProto or local Bot API server), and
# that is reported honestly by /limits, /health and at startup.
#
# 0 = no duration limit. Useful to reject very long videos on small instances.
MAX_DURATION_MINUTES=0

# Free disk space kept before a job starts (hosting constraint, not a file cap).
# A job that would eat into this is refused up front instead of failing halfway, and
# partial files are always deleted. Needs room for the video plus its remux.
MIN_FREE_DISK_MB=256

# ---------------------------------------------------------------------------
# 4. Download engine (TypeTube)
# ---------------------------------------------------------------------------
# Temporary workspace. Files are deleted right after upload.
DOWNLOAD_DIR=/tmp/ytbot-downloads
# The CLI is installed globally in the Docker image; override for a custom path.
# TYPETUBE_BIN=/usr/local/bin/typetube
# A private key lifts the per-IP cluster quota and unlocks Hi-Fi (256 kbps) audio.
TYPETUBE_API_KEY=
# Cluster host; empty = the CLI's own default.
TYPETUBE_HOST=
# Parallel range workers per download. 0 = automatic: 16 workers per CPU core, clamped
# to 8-32, read from the container's own CPU quota. Set a number to override.
TYPETUBE_WORKERS=0
# Bytes fetched per range request; 10 MB is what the CLI itself uses by default.
TYPETUBE_CHUNK_MB=10
# Node.js is required by the CLI (22.15+). Override only for a non-standard install.
# NODE_BINARY=/usr/local/bin/node
# Override only when FFmpeg is not on PATH (the Docker image installs it).
# The file must be named exactly "ffmpeg": the engine spawns it by that name.
# FFMPEG_BINARY=/usr/bin/ffmpeg
# FFPROBE_BINARY=/usr/bin/ffprobe

# ---------------------------------------------------------------------------
# 4b. Fetcher (aria2) — torrents, magnets and direct links
# ---------------------------------------------------------------------------
# aria2c fetches magnets, .torrent files and plain file URLs. It ships in the Docker
# image (apt-get install aria2); override only for a non-standard install.
# ARIA2_BINARY=aria2c
# How long to wait for peers to hand over a magnet link's file list.
TORRENT_METADATA_TIMEOUT=180
# A bot that fetches any URL a stranger sends is a request-forgery tool aimed at whatever
# network it runs in (cloud metadata endpoints, other containers). Since 3.3.3 links that
# point at loopback, private, link-local or reserved addresses are refused — set this to
# true ONLY for local testing.
ALLOW_PRIVATE_LINKS=false

# ---------------------------------------------------------------------------
# 5. Quality
# ---------------------------------------------------------------------------
# The quality highlighted in the picker when the link offers it.
# "best" picks the video's maximum; otherwise a height such as 720p or 480p.
DEFAULT_QUALITY=720p

# ---------------------------------------------------------------------------
# 6. Runtime and housekeeping
# ---------------------------------------------------------------------------
# How many downloads may run at once. 1-2 on a 512 MB instance.
MAX_CONCURRENT_JOBS=2
# Per-job ceiling; a stalled download is abandoned after this many seconds.
DOWNLOAD_TIMEOUT_SECONDS=3600
# Minimum seconds between status edits (Telegram allows ~1 message/second/chat).
PROGRESS_INTERVAL=2.0
# Fair-use pause between two links from the same user, in seconds. 0 switches it off.
# The owner is never throttled.
USER_COOLDOWN_SECONDS=5
# Status-message edits are spaced by at least this many seconds. Telegram allows about one
# message per second per chat, so 5 keeps a busy bot clear of the limit while the card still
# shows live speed and ETA (the first real numbers always appear immediately).
PROGRESS_MIN_INTERVAL=5.0
# Show the operator's @username on /start. Off by default: nothing about the owner is
# advertised to strangers, and the owner already knows their own handle.
SHOW_OWNER_IN_START=false
# Animated status cards and the /start picture. false = plain text, smaller API traffic.
RICH_MESSAGES=true
# Where Telegram's file ids for the shipped images are cached, so each image is uploaded
# once. Defaults to <DOWNLOAD_DIR>/.asset-cache.json.
# ASSET_CACHE_PATH=/tmp/ytbot-downloads/.asset-cache.json
# Debugging: keep the files of failed jobs instead of deleting them.
# KEEP_FAILED_FILES=false

# ---------------------------------------------------------------------------
# 7. Web service
# ---------------------------------------------------------------------------
# Public https URL of this service. When set, the bot runs in webhook mode and
# serves /health and /stats on PORT. When empty, it falls back to long polling.
# On Render, RENDER_EXTERNAL_URL is used automatically and wins over a WEBHOOK_URL that
# points at a different host: a URL left over from a renamed service sends every update
# to a host that no longer answers, and the bot then looks offline while reporting
# perfect health. If Telegram refuses the webhook anyway, the bot falls back to long
# polling instead of pretending to be ready.
WEBHOOK_URL=
# Path Telegram posts updates to: https://your-service/telegram
WEBHOOK_PATH=telegram
# Recommended. Telegram echoes this value in the X-Telegram-Bot-Api-Secret-Token
# header on every update; requests without it are rejected with 403.
# Generate one with:  python -c "import secrets;print(secrets.token_hex(16))"
WEBHOOK_SECRET=
# PORT is provided by the platform (Render, Voroa, Fly). 8080 for local runs.
PORT=8080
LISTEN_HOST=0.0.0.0
# Force long polling even when WEBHOOK_URL is set.
USE_POLLING=false

# ---------------------------------------------------------------------------
# 8. Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_PRETTY=true
