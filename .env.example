# Copy to .env and fill in. Every value here has a default in config.py, so the
# only truly required entries are BOT_TOKEN and (for a Web Service) WEBHOOK_URL.
#
#   cp .env.example .env
#   python main.py --check        # validates everything below
#
# ---------------------------------------------------------------------------
# 1. Telegram
# ---------------------------------------------------------------------------
# From @BotFather → your bot → API Token. Looks like 123456789:AA...
BOT_TOKEN=

# Leave empty to use Telegram's cloud Bot API (50 MB bot upload limit).
# Point it at a local Bot API server to reach 2000 MB:
#   TELEGRAM_API_BASE=http://telegram-bot-api:8081
# See docs/DEPLOYMENT.md → "Larger than 50 MB" (docker-compose.yml does it for you).
TELEGRAM_API_BASE=

# Optional: receive the startup summary in this chat. Send /id to the bot to find it.
STARTUP_NOTIFY_CHAT_ID=0
# Optional: your own user id; used as a fallback recipient for the startup summary.
OWNER_USER_ID=0

# ---------------------------------------------------------------------------
# 2. Upload limits
# ---------------------------------------------------------------------------
# 0 = decide automatically: 50 MB on the cloud API, 2000 MB with a local server.
# Set a smaller number to keep jobs small (e.g. 50 on a metered connection).
MAX_UPLOAD_MB=0
# 0 = no duration limit. Useful to reject very long videos on small instances.
MAX_DURATION_MINUTES=0

# ---------------------------------------------------------------------------
# 3. Downloads (yt-dlp)
# ---------------------------------------------------------------------------
# Temporary workspace. Files are deleted right after upload.
DOWNLOAD_DIR=/tmp/ytbot-downloads
# Override only when FFmpeg is not on PATH (the Docker image installs it).
# FFMPEG_BINARY=/usr/bin/ffmpeg
# FFPROBE_BINARY=/usr/bin/ffprobe

# Cookies let the bot download age-restricted, private or members-only videos.
# Export them with a browser extension in Netscape format, then point here.
# COOKIES_FILE=/app/cookies.txt

# Optional outbound proxy, e.g. http://user:pass@host:3128
PROXY=
# Parallel range requests per download. 4 is safe; raise on a fast link.
FRAGMENT_CONCURRENCY=4
# Per-job ceiling; a stalled download is abandoned after this many seconds.
DOWNLOAD_TIMEOUT_SECONDS=3600
# yt-dlp network behaviour.
YTDLP_SOCKET_TIMEOUT=30
YTDLP_RETRIES=10
# Prefer formats that need no re-encoding where quality is equal.
PREFER_FREE_FORMATS=true
# Set true to accept a playlist link (only the first item is used).
ALLOW_PLAYLIST=false
# Testing only: allow links that resolve to private/loopback addresses. Leave false
# in production — it is the guard against SSRF into your own network.
ALLOW_PRIVATE_URLS=false

# ---------------------------------------------------------------------------
# 4. Quality and formats
# ---------------------------------------------------------------------------
# The ladder offered in the buttons; only qualities the link really has are shown.
QUALITY_LADDER=144,240,360,480,720,1080,1440,2160
DEFAULT_QUALITY=720p
# m4a plays everywhere in Telegram; mp3 is bigger but familiar.
AUDIO_FORMAT=m4a
OFFER_AUDIO_ONLY=true

# ---------------------------------------------------------------------------
# 5. Uploads to Telegram
# ---------------------------------------------------------------------------
# Minimum seconds between status edits (Telegram allows ~1 message/second/chat).
PROGRESS_INTERVAL=2.0
# Thumbnail width cap; Telegram rejects thumbnails over 320 px or 200 kB.
THUMBNAIL_MAX_SIDE=320

# ---------------------------------------------------------------------------
# 6. Runtime and housekeeping
# ---------------------------------------------------------------------------
# How many downloads may run at once. 1-2 on a 512 MB instance.
MAX_CONCURRENT_JOBS=2
# Delete each file as soon as it has been uploaded.
CLEANUP_AFTER_UPLOAD=true
# Keep the files of failed jobs for debugging (they are deleted on restart).
KEEP_FAILED_FILES=false

# ---------------------------------------------------------------------------
# 7. Web service
# ---------------------------------------------------------------------------
# Public https URL of this service. When set, the bot runs in webhook mode and
# serves /health and /stats on PORT. When empty, it falls back to long polling.
# On Render this is detected automatically from RENDER_EXTERNAL_URL.
WEBHOOK_URL=
# Path Telegram posts updates to: https://your-service/telegram
WEBHOOK_PATH=telegram
# Recommended. Telegram echoes this value in the X-Telegram-Bot-Api-Secret-Token
# header on every update; requests without it are rejected with 403.
# Generate one with:  python -c "import secrets;print(secrets.token_hex(16))"
WEBHOOK_SECRET=
# PORT is provided by the platform (Render, Voroa, Fly). 8080 for local runs.
PORT=8080
LISTEN_HOST=0.0.0.0
# Force long polling even when WEBHOOK_URL is set.
USE_POLLING=false

# ---------------------------------------------------------------------------
# 8. Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_PRETTY=true
